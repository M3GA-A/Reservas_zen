# Este archivo sirve como ejemplo de la configuración que necesita el proyecto.
# No contiene las claves reales. Para usarlo, copia sus variables al archivo .env.

# Clave interna utilizada por Flask para proteger las sesiones.
SECRET_KEY=genera-una-clave-aleatoria-larga

# Clave que utiliza el administrador para entrar al panel.
ADMIN_ACCESS_KEY=escribe-aqui-tu-clave-de-acceso

# En desarrollo local debe permanecer en false.
# En una web publicada con HTTPS se recomienda cambiarla a true.
COOKIE_SECURE=false

# Activa o desactiva el modo de depuración de Flask.
# Por seguridad debe permanecer en false cuando la web esté publicada.
FLASK_DEBUG=false
